<Window x:Class="shopWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація" Height="480" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Border Padding="25" Background="White" CornerRadius="4" Margin="20" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Вхід у систему" FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#333333"/>

            <TextBlock Text="Логін:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                     Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"
                     BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="Пароль:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="pwdPassword" 
                         Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,20"
                         BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" 
                       HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <Button Content="Забули пароль?" Command="{Binding OpenRecoveryCommand}" 
                    Background="Transparent" BorderThickness="0" Foreground="#D4849A" 
                    Margin="0,0,0,15" Cursor="Hand"/>

            <Button Content="Увійти" IsDefault="True" Command="{Binding SignInCommand}" 
                    Height="38" Background="#D4849A" Foreground="White" 
                    FontWeight="Bold" FontSize="14" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>

            <Button Content="Зареєструватися" Command="{Binding OpenRegistrationCommand}" 
                    Height="38" Background="White" Foreground="#D4849A" 
                    FontWeight="Bold" FontSize="14" BorderBrush="#D4849A" BorderThickness="1" Cursor="Hand"/>

        </StackPanel>
    </Border>
</Window>