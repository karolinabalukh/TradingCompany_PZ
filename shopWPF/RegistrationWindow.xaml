<Window x:Class="shopWPF.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Padding="25" Background="White" CornerRadius="4" Margin="20" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Реєстрація користувача" FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333333"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Логін:"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Ім'я:"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Прізвище:"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email:"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Телефон:"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Стать:"/>
                    <ComboBox Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,12" Background="#FAFAFA" BorderBrush="#CCCCCC">
                        <ComboBoxItem Content="Ч"/>
                        <ComboBoxItem Content="Ж"/>
                    </ComboBox>

                    <TextBlock Text="Адреса:"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Секретне слово (для відновлення):"/>
                    <TextBox Text="{Binding SecretWord, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Номер банківської картки (16 цифр):"/>
                    <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Пароль:"/>
                    <PasswordBox x:Name="pwdPassword"/>

                    <TextBlock Text="Підтвердіть пароль:"/>
                    <PasswordBox x:Name="pwdConfirmPassword" Margin="0,0,0,20"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontWeight="Normal" 
                       HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Скасувати" Command="{Binding CancelCommand}" 
                        Width="120" Height="38" Background="White" Foreground="#777777" Margin="0,0,15,0"
                        FontWeight="Bold" FontSize="14" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>

                <Button Content="Зареєструватися" Command="{Binding RegisterCommand}" IsDefault="True" 
                        Width="140" Height="38" Background="#D4849A" Foreground="White"
                        FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>