<Window x:Class="shopWPF.PasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Відновлення пароля" Width="350" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Border Padding="25" Background="White" CornerRadius="4" Margin="20" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel>

            <TextBlock Text="Зміна пароля" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#333333"/>

            <TextBlock Text="Логін:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                     Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"
                     BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="Секретне слово:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SecretWord, UpdateSourceTrigger=PropertyChanged}" 
                     Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"
                     BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="Новий пароль:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="pwdNewPassword" 
                         Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"
                         BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="Підтвердіть пароль:" Foreground="#555555" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="pwdConfirmPassword" 
                         Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,20"
                         BorderBrush="#CCCCCC" BorderThickness="1"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" 
                       HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Скасувати" Command="{Binding CancelCommand}" 
                        Height="38" Background="White" Foreground="#777777" Margin="0,0,5,0"
                        FontWeight="Bold" FontSize="14" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>

                <Button Grid.Column="1" Content="Змінити" Command="{Binding RecoverCommand}" IsDefault="True" 
                        Height="38" Background="#D4849A" Foreground="White" Margin="5,0,0,0"
                        FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>