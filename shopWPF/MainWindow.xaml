<Window x:Class="shopWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trading Company - Каталог" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadProductsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="ProductItemTemplate">
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="5" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#333333" Text="{Binding ProductName}"/>
                        <TextBlock Text="{Binding QuantityInStock, StringFormat='В наявності: {0} шт.'}" 
                                   FontSize="13" Foreground="#777777" Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:C2}'}" 
                               FontSize="20" FontWeight="Heavy" Foreground="#D4849A" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{Binding WelcomeMessage}" FontSize="22" FontWeight="Bold" 
                   Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Content="Увійти / Реєстрація" Command="{Binding OpenLoginCommand}" 
                HorizontalAlignment="Right" Background="#D4849A" Foreground="White" 
                Padding="15,5" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" Margin="15"
                 ItemsSource="{Binding Products}" 
                 ItemTemplate="{StaticResource ProductItemTemplate}"
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"/>
    </Grid>
</Window>